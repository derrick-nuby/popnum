{
  "manifest_version": 3,
  "name": "PopNum - Random Number Populator",
  "version": "1.0",
  "description": "Fills form fields with random numbers within a configurable range",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Populate with Random Numbers"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}